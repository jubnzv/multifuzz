# multifuzz configuration.
# Copy to ./multifuzz.toml (or pass --config <path>).

# ── Build ────────────────────────────────────────────────────────────────
# Build commands executed via `sh -c`. Defaults shown below.
# `multifuzz build` always runs them; `multifuzz fuzz` skips by default.
[build]
# always_build = true  # Build before fuzzing (default: false)
# afl = "AFL_QUIET=1 cargo afl build --release --features=multifuzz/afl --target-dir=target/afl"
# afl_cmplog = "AFL_QUIET=1 AFL_LLVM_CMPLOG=1 cargo afl build --release --features=multifuzz/afl --target-dir=target/afl-cmplog"
# honggfuzz = "CARGO_TARGET_DIR=./target/honggfuzz HFUZZ_BUILD_ARGS='--features=multifuzz/honggfuzz' cargo hfuzz build"
# libfuzzer = "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS='-Cpasses=sancov-module -Cllvm-args=-sanitizer-coverage-level=4 -Cllvm-args=-sanitizer-coverage-trace-compares -Cllvm-args=-sanitizer-coverage-inline-8bit-counters -Cllvm-args=-sanitizer-coverage-pc-table' cargo build --release --target=x86_64-unknown-linux-gnu --features=multifuzz/libfuzzer --target-dir=target/libfuzzer"

# ── Fuzz ─────────────────────────────────────────────────────────────────
[fuzz]
target = "multifuzz_source_fuzzer"        # Binary name of the fuzz harness (required)
corpus = "../../source_corpus"            # Initial seed corpus directory
output = "../../output/multi"             # Output directory (default: ./output)
timeout = 10                              # Per-exec timeout in seconds
max_input_size = 8192                     # Max input size in bytes (default: 8192)
sync_interval = 60                        # Corpus sync interval in minutes; 0 or omit to disable
# no_colors = true                        # Disable colored output (default: false)
dictionaries = [                          # Dictionary files
    "../../dicts/move.dict",
    "../../dicts/move_rare.dict",
    "../../dicts/crash.dict",
]
external_corpus = ["/tmp/move-corpus"]    # External corpus dirs imported during sync
# external_corpus_recursive = true        # Recurse into external corpus subdirs (default: false)

# ── AFL++ workers ────────────────────────────────────────────────────────
# Number of workers = number of [fuzz.afl.workerN] sections (worker0 = master).
# [fuzz.afl.all.env] sets base env vars for EVERY AFL worker.
# [fuzz.afl.workerN] overrides for specific worker N.
# Worker env = all.env + workerN.env merged (worker wins on conflict).
#
# Per-worker fields:
#   args    = "..."   Extra CLI args (power schedule, cmplog, old queue, etc.)
#   command = "..."   Full command override (executed via sh -c; replaces auto-generated)
#   env     = {...}   Env vars for this worker
#
# The auto-generated command is MINIMAL: -M/-S, -i, -o, -t, -G, dicts, -F (sync).
# Everything else goes in args.
# If any worker has a cmplog -l flag, the afl_cmplog binary is built automatically
# and -c is injected into that worker's command.

[fuzz.afl.all.env]
AFL_AUTORESUME = "1"
AFL_FAST_CAL = "1"
AFL_FORCE_UI = "1"
AFL_IGNORE_UNKNOWN_ENVS = "1"
AFL_CMPLOG_ONLY_NEW = "1"
AFL_DISABLE_TRIM = "1"
AFL_NO_WARN_INSTABILITY = "1"
AFL_FUZZER_STATS_UPDATE_INTERVAL = "10"
AFL_IGNORE_SEED_PROBLEMS = "1"

# Master instance.
[fuzz.afl.worker0]
args = "-pexplore"

[fuzz.afl.worker0.env]
AFL_FINAL_SYNC = "1"

# Secondary with custom mutator.
[fuzz.afl.worker1]
args = "-pfast"

[fuzz.afl.worker1.env]
AFL_CUSTOM_MUTATOR_LIBRARY = "~/Sources/AFLplusplus/custom_mutators/radamsa/radamsa-mutator.so"
AFL_CUSTOM_MUTATOR_ONLY = "1"

# Secondary with cmplog (triggers cmplog binary build + auto -c injection).
[fuzz.afl.worker2]
args = "-pcoe -l2a"

# Secondary with grammar mutator.
[fuzz.afl.worker3]
args = "-pexploit"

[fuzz.afl.worker3.env]
AFL_CUSTOM_MUTATOR_LIBRARY = "~/Sources/AFLplusplus/custom_mutators/grammar_mutator/grammar_mutator.so"

# Full command override example (uncomment to use):
# [fuzz.afl.worker3]
# command = "cargo afl fuzz -Sgrammar -i ../../source_corpus -o ../../output/multi/afl -pexplore -G8192 ./target/afl/debug/multifuzz_source_fuzzer"

# ── Honggfuzz ────────────────────────────────────────────────────────────
# Present = enabled. Absent = disabled.
#
# command = full shell command to launch honggfuzz (required).
# args    = appended to HFUZZ_RUN_ARGS after structural paths.
# env     = extra env vars passed to the process.
#
# Multifuzz manages (DO NOT set in env/args):
#   HFUZZ_WORKSPACE, HFUZZ_RUN_ARGS, CARGO_TARGET_DIR,
#   --input, -o, --dynamic_input
#
# [fuzz.honggfuzz.worker]
# command = "HFUZZ_BUILD_ARGS='--features=multifuzz/honggfuzz' script --flush --quiet -c 'cargo hfuzz run multifuzz_source_fuzzer' /dev/null"
# args = "-n1 -F8192 -t5 -w ../../dicts/move.dict"

# ── Libfuzzer ────────────────────────────────────────────────────────────
# Present = enabled. Absent = disabled.
#
# args = appended after structural args (corpus dirs, -artifact_prefix).
# env  = extra env vars passed to the process.
#
# Multifuzz manages (DO NOT set in args):
#   corpus dir positional args, -artifact_prefix
#
# [fuzz.libfuzzer.worker]
# args = "-fork=1 -reload=1 -max_len=8192 -timeout=5 -ignore_crashes=1 -ignore_ooms=1"
