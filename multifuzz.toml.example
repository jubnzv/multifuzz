# Example multifuzz config.
# Copy to ./multifuzz.toml (or pass --config <path>).
#
# Equivalent to:
#   AFL_SKIP_CPUFREQ=1 cargo run --release --manifest-path ~/Dev/multifuzz/Cargo.toml \
#     -- fuzz multifuzz_source_fuzzer --sync-interval 60 \
#     -i ../../source_corpus -o ../../output/multi \
#     -x ../../dicts/move.dict -x ../../dicts/move_rare.dict -x ../../dicts/crash.dict \
#     -t 10 --external-corpus /tmp/move-corpus
#
# With this config in place, the invocation simplifies to:
#   AFL_SKIP_CPUFREQ=1 cargo run --release -- fuzz

[build]
# no_build = true  # Skip build entirely, use existing binaries.
# Defaults shown below. Uncomment to override.
# afl = "AFL_QUIET=1 cargo afl build --features=multifuzz/afl --target-dir=target/afl"
# afl_cmplog = "AFL_QUIET=1 AFL_LLVM_CMPLOG=1 cargo afl build --features=multifuzz/afl --target-dir=target/afl-cmplog"
# honggfuzz = "CARGO_TARGET_DIR=./target/honggfuzz HFUZZ_BUILD_ARGS='--features=multifuzz/honggfuzz' cargo hfuzz build-debug"
# libfuzzer = "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS='-Cpasses=sancov-module -Cllvm-args=-sanitizer-coverage-level=4 -Cllvm-args=-sanitizer-coverage-trace-compares -Cllvm-args=-sanitizer-coverage-inline-8bit-counters -Cllvm-args=-sanitizer-coverage-pc-table' cargo build --release --target=x86_64-unknown-linux-gnu --features=multifuzz/libfuzzer --target-dir=target/libfuzzer"

[fuzz]
target = "multifuzz_source_fuzzer"
corpus = "../../source_corpus"
output = "../../output/multi"
timeout = 10
sync_interval = 60
dictionaries = [
    "../../dicts/move.dict",
    "../../dicts/move_rare.dict",
    "../../dicts/crash.dict",
]
external_corpus = ["/tmp/move-corpus"]

# Per-worker AFL++ configuration.
# NO hardcoded env defaults — everything is explicit in the config.
#
# [fuzz.afl.all.env]   — base env vars applied to EVERY AFL worker.
# [fuzz.afl.workerN]   — per-worker overrides (0=main, 1+=secondary).
#
# Worker env = all.env merged with workerN.env (worker wins on conflict).
# At startup, the resolved env + command is printed per worker.
#
# Optional per-worker fields:
#   args = "..."     # Extra CLI args (power schedule, cmplog, etc.)
#   command = "..."  # Full command override (executed via sh -c)
#
# The auto-generated command is MINIMAL: -M/-S, -i, -o, -t, -G, dicts.
# Everything else (power schedule, cmplog, old queue) goes in args.

[fuzz.afl.all.env]
AFL_AUTORESUME = "1"
AFL_FAST_CAL = "1"
AFL_FORCE_UI = "1"
AFL_IGNORE_UNKNOWN_ENVS = "1"
AFL_CMPLOG_ONLY_NEW = "1"
AFL_DISABLE_TRIM = "1"
AFL_NO_WARN_INSTABILITY = "1"
AFL_FUZZER_STATS_UPDATE_INTERVAL = "10"
AFL_IGNORE_SEED_PROBLEMS = "1"

# Main instance.
[fuzz.afl.worker0]
args = "-pexplore"

[fuzz.afl.worker0.env]
AFL_FINAL_SYNC = "1"

# Secondary with custom mutator.
[fuzz.afl.worker1]
args = "-pfast"

[fuzz.afl.worker1.env]
AFL_CUSTOM_MUTATOR_LIBRARY = "~/Sources/AFLplusplus/custom_mutators/radamsa/radamsa-mutator.so"
AFL_CUSTOM_MUTATOR_ONLY = "1"

# Secondary with cmplog.
[fuzz.afl.worker2]
args = "-pcoe -l2a"

# Secondary with grammar mutator.
[fuzz.afl.worker3]
args = "-pexploit"

[fuzz.afl.worker3.env]
AFL_CUSTOM_MUTATOR_LIBRARY = "~/Sources/AFLplusplus/custom_mutators/grammar_mutator/grammar_mutator.so"

# Fully custom command example (uncomment to use):
# [fuzz.afl.worker3]
# command = "cargo afl fuzz -Sgrammar -i ../../source_corpus -o ../../output/multi/afl -pexplore -G8192 ./target/afl/debug/multifuzz_source_fuzzer"

# ── Satellite engines ──────────────────────────────────────────────────
# Present = enabled. Absent = disabled. Each takes 1 slot from total jobs.
# Internal parallelism (threads/forks) is controlled via args.

# Honggfuzz: extra args appended to the auto-generated command.
# [fuzz.honggfuzz.worker]
# args = "-n1"
#
# [fuzz.honggfuzz.worker.env]
# CUSTOM_VAR = "value"

# Libfuzzer: extra args appended to the auto-generated command.
# [fuzz.libfuzzer.worker]
# args = "-fork=1"
#
# [fuzz.libfuzzer.worker.env]
# CUSTOM_VAR = "value"
